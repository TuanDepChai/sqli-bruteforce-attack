<group name="sqli-bruteforce-attacks,">

<!-- SQL Injection Detection -->
<rule id="100001" level="12">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="attack_type">sql_injection</field>
  <description>SQL Injection attack detected</description>
  <group>attack,sql_injection,</group>
  <options>no_full_log</options>
  <info type="link">https://owasp.org/www-community/attacks/SQL_Injection</info>
</rule>

<!-- Brute Force Detection -->
<rule id="100002" level="10">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="attack_type">brute_force</field>
  <description>Brute Force attack detected</description>
  <group>attack,brute_force,</group>
  <options>no_full_log</options>
  <info type="link">https://owasp.org/www-community/attacks/Brute_force_attack</info>
</rule>

<!-- Credential Stuffing Detection -->
<rule id="100003" level="11">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="attack_type">credential_stuffing</field>
  <description>Credential Stuffing attack detected</description>
  <group>attack,credential_stuffing,</group>
  <options>no_full_log</options>
  <info type="link">https://owasp.org/www-community/attacks/Credential_stuffing</info>
</rule>

<!-- Failed Login Attempts -->
<rule id="100004" level="5">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="status_code">401</field>
  <description>Failed login attempt</description>
  <group>authentication,failed_login,</group>
  <options>no_full_log</options>
</rule>

<!-- Successful Login -->
<rule id="100005" level="3">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="status_code">200</field>
  <field name="login_result">Authentication successful</field>
  <description>Successful authentication</description>
  <group>authentication,successful_login,</group>
  <options>no_full_log</options>
</rule>

<!-- High Risk Score Alert -->
<rule id="100006" level="8">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="risk_score">>80</field>
  <description>High risk attack detected</description>
  <group>attack,high_risk,</group>
  <options>no_full_log</options>
</rule>

<!-- Critical Severity Alert -->
<rule id="100007" level="15">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="attack_severity">critical</field>
  <description>Critical severity attack detected</description>
  <group>attack,critical,</group>
  <options>no_full_log</options>
</rule>

<!-- SQL Query Analysis -->
<rule id="100008" level="8">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <regex>OR.*1.*=.*1|UNION.*SELECT|--|/\*</regex>
  <field name="sql_query">OR.*1.*=.*1|UNION.*SELECT|--|/\*</field>
  <description>Suspicious SQL query pattern detected</description>
  <group>attack,sql_injection,patterns,</group>
  <options>no_full_log</options>
</rule>

<!-- Performance Analysis -->
<rule id="100009" level="7">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="response_time_ms">>5000</field>
  <description>High response time during attack - potential DoS</description>
  <group>attack,performance,</group>
  <options>no_full_log</options>
</rule>

<!-- Large Payload Analysis -->
<rule id="100010" level="7">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <field name="payload_size_bytes">>1000</field>
  <description>Large payload size detected</description>
  <group>attack,large_payload,</group>
  <options>no_full_log</options>
</rule>

<!-- Suspicious User Agents -->
<rule id="100011" level="6">
  <decoded_as>sqli-bruteforce-json</decoded_as>
  <regex>curl|wget|python|bot|scanner</regex>
  <field name="user_agent">curl|wget|python|bot|scanner</field>
  <description>Unusual user agent detected</description>
  <group>attack,suspicious_ua,</group>
  <options>no_full_log</options>
</rule>

</group>

