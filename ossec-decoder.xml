<?xml version="1.0" encoding="UTF-8"?>
<decoder name="sqli-bruteforce">
  <program_name>^sqli-bruteforce</program_name>
</decoder>

<decoder name="sqli-bruteforce-log">
  <parent>sqli-bruteforce</parent>
  <regex type="pcre2">^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3} [+-]\d{2}:\d{2}) (\S+) (\w+) (\S+) (\S+) (\d{3}) "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)" "([^"]*)"$</regex>
  <order>timestamp, srcip, method, uri, query_string, status_code, user_agent, message, error, session_token, attack_type, sql_query, referer, response_time, payload_size, headers</order>
  <fts>timestamp, srcip, method, uri, status_code, user_agent, message, attack_type, sql_query</fts>
</decoder>

<decoder name="sqli-bruteforce-attack">
  <parent>sqli-bruteforce-log</parent>
  <regex type="pcre2">sql_injection|brute_force</regex>
  <order>attack_type</order>
</decoder>

<decoder name="sqli-bruteforce-sql-injection">
  <parent>sqli-bruteforce-attack</parent>
  <regex type="pcre2">sql_injection</regex>
  <order>attack_type</order>
</decoder>

<decoder name="sqli-bruteforce-brute-force">
  <parent>sqli-bruteforce-attack</parent>
  <regex type="pcre2">brute_force</regex>
  <order>attack_type</order>
</decoder>
